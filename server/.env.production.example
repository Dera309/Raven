# Raven Server Production Environment Variables
# Copy this file to .env and fill in the actual values for production deployment

# Server Configuration
PORT=8000

# Database
# Get your MongoDB Atlas connection string from https://cloud.mongodb.com
# Ensure your IP whitelist includes your server's IP address
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/raven_db?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
# IMPORTANT: Generate a strong secret for production using:
# openssl rand -hex 64 (Linux/Mac)
# or visit https://generate-secret.vercel.app/256 (online)
JWT_SECRET=<your-super-secure-256-bit-random-string>

# Environment
# IMPORTANT: Set to 'production' for production deployment
NODE_ENV=production

# Frontend URL
# Update this to your production frontend URL (without trailing slash)
FRONTEND_URL=https://your-frontend-domain.com

# Cloudinary Configuration (for image uploads)
# Sign up at https://cloudinary.com and create a free account
# Go to Settings > Upload > Upload presets to configure
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Payment Configuration - Paystack (for Nigerian payments)
# Register at https://paystack.com and complete business verification
# Use live keys (starts with sk_live_) for production
PAYSTACK_SECRET_KEY=sk_live_<your-live-secret-key>
PAYSTACK_PUBLIC_KEY=pk_live_<your-live-public-key>

# Rate Limiting (adjust based on your traffic needs)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window per IP
