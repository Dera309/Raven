# Raven Server Development Environment Variables
# Copy this file to .env for local development

# Server Configuration
PORT=8000

# Database
# For local development, you can use a local MongoDB instance or Atlas free tier
# Local: MONGO_URI=mongodb://localhost:27017/raven_db
MONGO_URI=mongodb+srv://chideraobia7_db_user:TuqFHSaHUF72s0hj@cluster0.9ljjq57.mongodb.net/raven_db?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
# For development, you can use any string (minimum 32 characters recommended)
# For production, generate a secure random string
JWT_SECRET=dev-secret-key-change-in-production-a01299a5f8dae08e70695325e3509d5e

# Environment
# Set to 'development' for local development, 'production' for deployment
NODE_ENV=development

# Frontend URL
# For local Next.js development, this is typically localhost:3000
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration (for image uploads)
# Sign up at https://cloudinary.com and use free tier for development
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment Configuration - Paystack
# Use test keys (starts with sk_test_) for development
# Get test keys from https://dashboard.paystack.com/testimonials
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Rate Limiting (more lenient for development)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100   # Higher limit for development testing
