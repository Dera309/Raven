import mongoose from 'mongoose';
import dotenv from 'dotenv';
import connectDB from './config/db';
import User, { UserRole } from './models/User';
import ArtistProfile from './models/ArtistProfile';
import VixenProfile from './models/VixenProfile';
import bcrypt from 'bcryptjs';

dotenv.config();

const seedData = async () => {
    try {
        await connectDB();
        console.log('Connected to DB');

        // Clear existing data
        await User.deleteMany({});
        await ArtistProfile.deleteMany({});
        await VixenProfile.deleteMany({});
        console.log('Cleared existing data');

        // Create Artist User
        const artistSalt = await bcrypt.genSalt(10);
        const artistPassword = await bcrypt.hash('password123', artistSalt);

        const artistUser = await User.create({
            name: 'Test Artist',
            email: 'artist@test.com',
            password: artistPassword,
            role: UserRole.ARTIST,
            phone: '1234567890',
            isVerified: true
        });

        await ArtistProfile.create({
            user: artistUser._id,
            stageName: 'Lil Tester',
            bio: 'Up and coming artist testing the platform',
            genre: ['Hip Hop', 'Afrobeats'],
            location: 'Lagos, Nigeria'
        });
        console.log('Created Artist User');

        // Create Vixen User
        const vixenSalt = await bcrypt.genSalt(10);
        const vixenPassword = await bcrypt.hash('password123', vixenSalt);

        const vixenUser = await User.create({
            name: 'Test Vixen',
            email: 'vixen@test.com',
            password: vixenPassword,
            role: UserRole.VIXEN,
            phone: '0987654321',
            isVerified: true
        });

        await VixenProfile.create({
            user: vixenUser._id,
            stageName: 'Vixen Queen',
            bio: 'Professional video vixen with 5 years experience',
            location: 'Accra, Ghana',
            rate: 50000,
            currency: 'NGN',
            isAvailable: true,
            measurements: {
                height: '5ft 9in',
                bust: '34',
                waist: '26',
                hips: '38',
                shoeSize: '8'
            }
        });
        console.log('Created Vixen User');

        // Create Admin User
        // ⚠️ IMPORTANT: Change these credentials to your own!
        const adminSalt = await bcrypt.genSalt(10);
        const adminPassword = await bcrypt.hash('your-secure-password-here', adminSalt);

        await User.create({
            name: 'Admin User',
            email: 'your-email@example.com',
            password: adminPassword,
            role: UserRole.ADMIN,
            isVerified: true
        });
        console.log('Created Admin User');

        console.log('Seeding completed successfully');
        process.exit(0);
    } catch (error) {
        console.error('Error seeding data:', error);
        process.exit(1);
    }
};

seedData();
